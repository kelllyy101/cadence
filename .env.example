# Cadence environment variables. Copy to .env and adjust. Never put real secrets here.

# --- API ---
# development | test | production
NODE_ENV=development
# Port the GraphQL API listens on.
API_PORT=4000
# Log level for pino: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
# MongoDB connection string. Single-node replica set (needed for transactions).
MONGO_URL=mongodb://localhost:27017/cadence?replicaSet=rs0&directConnection=true
# Comma-separated Kafka bootstrap servers (host listener).
KAFKA_BROKERS=localhost:9092

# --- Web ---
# GraphQL endpoint the browser calls (the web server proxies it).
VITE_API_URL=/graphql
# Where the web server proxies /graphql (Compose uses http://api:4000).
API_PROXY_TARGET=http://localhost:4000
